{
  "name": "site",
  "projectType": "application",
  "sourceRoot": "docs/site/docs",
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": [
        "{projectRoot}/.vitepress/dist"
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/docs/openapi.yaml",
        "{workspaceRoot}/docs/openapi.json"
      ]
    }
  }
}
